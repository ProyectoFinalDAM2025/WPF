<Window x:Class="app.View.Reportes.ReportesOfertas.ReporteOfertaDetalle"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ReporteOfertaDetalle" Height="600" Width="1000"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../Dictionary1.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="DetailLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#9CA3AF"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin" Value="0,10,0,2"/>
            </Style>

            <Style x:Key="DetailValue" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#1F2937"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Border CornerRadius="20" Background="#CC000000" BorderThickness="5">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#616161" Offset="1"/>
                    <GradientStop Color="#9CA3AF" Offset="0.75"/>
                    <GradientStop Color="#D9D9D9" Offset="0"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Border CornerRadius="25" Background="White" Width="760" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Margin="25">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse Width="70" Height="70" Stroke="#D9D9D9" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding EmpresaFoto}" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding OfertaTitulo}" Foreground="#06080D" FontSize="28" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding EmpresaNombre}" Foreground="#9CA3AF" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding Motivo}" Foreground="#616161" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2" Width="32" Height="32" Background="Transparent" BorderBrush="Transparent" Cursor="Hand" Click="Cerrar_Click">
                            <Path Data="M0,0 L12,12 M12,0 L0,12" Stroke="#9CA3AF" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,20">
                        <StackPanel>
                            <TextBlock Text="Reporte" Foreground="#06080D" FontSize="21" FontWeight="Bold"/>

                            <TextBlock Text="ID reporte" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Text="{Binding IDReporte}" Style="{StaticResource DetailValue}"/>

                            <TextBlock Text="Reportado por" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Text="{Binding UsuarioReporta}" Style="{StaticResource DetailValue}"/>

                            <TextBlock Text="Fecha del reporte" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Text="{Binding FechaCreacion}" Style="{StaticResource DetailValue}"/>

                            <TextBlock Text="Descripcion del reporte" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Text="{Binding Descripcion}" Style="{StaticResource DetailValue}"/>

                            <Border Height="1" Background="#D9D9D9" Margin="0,22,0,18"/>

                            <TextBlock Text="Oferta" Foreground="#06080D" FontSize="21" FontWeight="Bold"/>

                            <TextBlock Text="Titulo" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Text="{Binding OfertaTitulo}" Style="{StaticResource DetailValue}"/>

                            <TextBlock Text="Categoria" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Text="{Binding OfertaCategoria}" Style="{StaticResource DetailValue}"/>

                            <TextBlock Text="Ubicacion" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Text="{Binding OfertaUbicacion}" Style="{StaticResource DetailValue}"/>

                            <TextBlock Text="Estado" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Text="{Binding OfertaEstado}" Style="{StaticResource DetailValue}"/>

                            <TextBlock Text="Fecha de publicacion" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Text="{Binding OfertaFechaPublicacion}" Style="{StaticResource DetailValue}"/>

                            <TextBlock Text="Descripcion de la oferta" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Text="{Binding OfertaDescripcion}" Style="{StaticResource DetailValue}"/>

                            <Border Height="1" Background="#D9D9D9" Margin="0,22,0,18"/>

                            <TextBlock Text="Empresa" Foreground="#06080D" FontSize="21" FontWeight="Bold"/>

                            <TextBlock Text="Nombre" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Text="{Binding EmpresaNombre}" Style="{StaticResource DetailValue}"/>

                            <TextBlock Text="Sector" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Text="{Binding EmpresaSector}" Style="{StaticResource DetailValue}"/>

                            <TextBlock Text="Ubicacion" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Text="{Binding EmpresaUbicacion}" Style="{StaticResource DetailValue}"/>

                            <TextBlock Text="Sitio web" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Text="{Binding EmpresaSitioWeb}" Style="{StaticResource DetailValue}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Eliminar reporte" Height="42" Width="150" Margin="0,0,10,0"
                                Background="#D9D9D9" BorderBrush="White" Foreground="#616161" FontSize="15" Cursor="Hand"
                                Click="EliminarReporte_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="20"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Content="Moderar contenido" Height="42" Width="170" Margin="0,0,10,0"
                                Background="#616161" BorderBrush="White" Foreground="White" FontSize="15" Cursor="Hand"
                                Click="Moderar_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="20"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Content="Cerrar" Height="42" Width="130"
                                Background="#9CA3AF" BorderBrush="White" Foreground="White" FontSize="15" Cursor="Hand"
                                Click="Cerrar_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="20"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
