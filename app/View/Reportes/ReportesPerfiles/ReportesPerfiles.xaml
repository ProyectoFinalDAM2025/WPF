<Window x:Class="app.View.Reportes.ReportesPerfiles.ReportesPerfiles"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ReportesPerfiles" Height="600" Width="1000"
        WindowStyle="none"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../Dictionary1.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Border CornerRadius="20">
            <Border.Background>
                <ImageBrush ImageSource="/View/Home/oficina.jpg" Stretch="Fill"/>
            </Border.Background>

            <Border CornerRadius="20" Background="White" BorderThickness="5" Opacity="0.9">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#616161" Offset="1"/>
                        <GradientStop Color="#9CA3AF" Offset="0.75"/>
                        <GradientStop Color="#D9D9D9" Offset="0"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <DockPanel>
                            <Image Height="40" VerticalAlignment="Top" Margin="10,15,0,0" Source="/View/Usuarios/MainUsuarios/Icon.png" Cursor="Hand" MouseDown="IrInicio_MouseDown"/>
                            <Label Content="OFFICIUM" FontSize="27" Margin="5,10,25,0" FontWeight="Bold" MouseDown="IrInicio_MouseDown" Cursor="Hand"/>
                        </DockPanel>
                        <Button Content="Admins" Style="{StaticResource BarSide}" Click="Admins_Click"/>
                        <Button Content="Ofertas" Style="{StaticResource BarSide}" Click="Ofertas_Click"/>
                        <Button Content="Publicaciones" Width="150" Style="{StaticResource BarSide}" Click="Publicaciones_Click"/>
                        <Button Content="Perfiles" Width="120" Style="{StaticResource BarSide}"/>
                        <StackPanel VerticalAlignment="Center" Margin="15,0">
                            <TextBlock x:Name="txtUsuarioSession" HorizontalAlignment="Center" Text="Username" Foreground="#9CA3AF" FontSize="18"/>
                            <TextBlock x:Name="txtUsuarioRol" HorizontalAlignment="Center" FontSize="10" Text="Administrador" Foreground="#9CA3AF"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="35,0,35,25">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="75"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Canvas Grid.Row="0">
                            <Label Content="Reportes perfiles" Canvas.Left="0" FontSize="42" FontWeight="Bold" Foreground="#FF06080D"/>
                            <StackPanel Canvas.Right="0" Canvas.Top="18" Orientation="Horizontal">
                                <Image x:Name="imgToggleButton" Source="/View/Usuarios/MainUsuarios/imgDataGrid.png" Width="20" Margin="10,0"/>
                                <ToggleButton x:Name="btnToggleButtonCambiarLista"
                                              Checked="ToggleButtonCambiarLista_Checked"
                                              Unchecked="ToggleButtonCambiarLista_Unchecked"
                                              Cursor="Hand"
                                              Content="DataGrid"
                                              Background="Transparent"
                                              BorderBrush="Transparent"
                                              FontSize="23"/>
                            </StackPanel>
                        </Canvas>

                        <DataGrid x:Name="DataGridReportes" Grid.Row="1" Height="405" AutoGenerateColumns="False"
                                  HeadersVisibility="Column" GridLinesVisibility="None" Background="White"
                                  BorderBrush="Transparent" BorderThickness="0" CanUserAddRows="False"
                                  ItemsSource="{Binding Reportes}" SelectedItem="{Binding ReporteSeleccionado, Mode=TwoWay}">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="#FFF1F1F1"/>
                                    <Setter Property="Margin" Value="6"/>
                                    <Setter Property="Height" Value="62"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#D9D9D9"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#D9D9D9"/>
                                            <Setter Property="BorderBrush" Value="#9CA3AF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Width="80" Binding="{Binding IDReporte}"/>
                                <DataGridTextColumn Header="Perfil" Width="90" Binding="{Binding IDEntidad}"/>
                                <DataGridTextColumn Header="Nombre" Width="155" Binding="{Binding PerfilNombre}"/>
                                <DataGridTextColumn Header="Rol" Width="85" Binding="{Binding PerfilRol}"/>
                                <DataGridTextColumn Header="Motivo" Width="145" Binding="{Binding Motivo}"/>
                                <DataGridTextColumn Header="Estado" Width="90" Binding="{Binding Estado}"/>
                                <DataGridTextColumn Header="Fecha" Width="110" Binding="{Binding FechaCreacion}"/>
                                <DataGridTemplateColumn Header="Acciones" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="Ver" Width="50" Height="25" Margin="0,0,6,0" Background="#9CA3AF" BorderBrush="White" Foreground="White"
                                                        Command="{Binding DataContext.VerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                <Button Content="Eliminar" Width="65" Height="25" Background="#D9D9D9" BorderBrush="White" Foreground="#9CA3AF"
                                                        Command="{Binding DataContext.EliminarCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <ListView x:Name="ListViewReportes" Visibility="Collapsed" Grid.Row="1" Height="405"
                                  Background="White" BorderBrush="Transparent" BorderThickness="0"
                                  ItemsSource="{Binding Reportes}" SelectedItem="{Binding ReporteSeleccionado, Mode=TwoWay}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" Width="80" DisplayMemberBinding="{Binding IDReporte}"/>
                                    <GridViewColumn Header="Perfil" Width="90" DisplayMemberBinding="{Binding IDEntidad}"/>
                                    <GridViewColumn Header="Nombre" Width="170" DisplayMemberBinding="{Binding PerfilNombre}"/>
                                    <GridViewColumn Header="Rol" Width="90" DisplayMemberBinding="{Binding PerfilRol}"/>
                                    <GridViewColumn Header="Motivo" Width="155" DisplayMemberBinding="{Binding Motivo}"/>
                                    <GridViewColumn Header="Estado" Width="90" DisplayMemberBinding="{Binding Estado}"/>
                                    <GridViewColumn Header="Acciones" Width="135">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Ver" Width="50" Height="25" Margin="0,0,6,0" Background="#9CA3AF" BorderBrush="White" Foreground="White"
                                                            Command="{Binding DataContext.VerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    <Button Content="Eliminar" Width="65" Height="25" Background="#D9D9D9" BorderBrush="White" Foreground="#9CA3AF"
                                                            Command="{Binding DataContext.EliminarCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
