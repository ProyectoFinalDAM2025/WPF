<Window x:Class="app.View.Reportes.ReportesPublicaciones.ReportePublicacionDetalle"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ReportePublicacionDetalle" Height="600" Width="1000"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../Dictionary1.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="DetailLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#9CA3AF"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin" Value="0,10,0,2"/>
            </Style>

            <Style x:Key="DetailValue" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#1F2937"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Border CornerRadius="20" Background="#CC000000" BorderThickness="5">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#616161" Offset="1"/>
                    <GradientStop Color="#9CA3AF" Offset="0.75"/>
                    <GradientStop Color="#D9D9D9" Offset="0"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Border CornerRadius="25" Background="White" Width="800" Height="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Margin="25">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse Width="70" Height="70" Stroke="#D9D9D9" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding PublicacionAutorFoto}" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Reporte publicacion" Foreground="#06080D" FontSize="28" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding PublicacionAutor}" Foreground="#9CA3AF" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding Motivo}" Foreground="#616161" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2" Width="32" Height="32" Background="Transparent" BorderBrush="Transparent" Cursor="Hand" Click="Cerrar_Click">
                            <Path Data="M0,0 L12,12 M12,0 L0,12" Stroke="#9CA3AF" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,20">
                        <StackPanel>
                            <TextBlock Text="Reporte" Foreground="#06080D" FontSize="21" FontWeight="Bold"/>

                            <TextBlock Text="ID reporte" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Text="{Binding IDReporte}" Style="{StaticResource DetailValue}"/>

                            <TextBlock Text="Reportado por" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Text="{Binding UsuarioReporta}" Style="{StaticResource DetailValue}"/>

                            <TextBlock Text="Fecha del reporte" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Text="{Binding FechaCreacion}" Style="{StaticResource DetailValue}"/>

                            <TextBlock Text="Descripcion del reporte" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Text="{Binding Descripcion}" Style="{StaticResource DetailValue}"/>

                            <Border Height="1" Background="#D9D9D9" Margin="0,22,0,18"/>

                            <TextBlock Text="Publicacion" Foreground="#06080D" FontSize="21" FontWeight="Bold"/>

                            <TextBlock Text="Autor" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Text="{Binding PublicacionAutor}" Style="{StaticResource DetailValue}"/>

                            <TextBlock Text="Email" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Text="{Binding PublicacionAutorEmail}" Style="{StaticResource DetailValue}"/>

                            <TextBlock Text="Grupo" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Text="{Binding PublicacionGrupo}" Style="{StaticResource DetailValue}"/>

                            <TextBlock Text="Fecha de publicacion" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Text="{Binding PublicacionFecha}" Style="{StaticResource DetailValue}"/>

                            <TextBlock Text="Contenido" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Text="{Binding PublicacionContenido}" Style="{StaticResource DetailValue}"/>

                            <Border Height="1" Background="#D9D9D9" Margin="0,22,0,18"/>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" LastChildFill="True">
                                    <TextBlock Text="Documento" Foreground="#06080D" FontSize="21" FontWeight="Bold"/>
                                    <Button x:Name="btnAbrirDocumento" Content="Abrir" Height="30" Width="90" HorizontalAlignment="Right"
                                            DockPanel.Dock="Right" Background="#9CA3AF" BorderBrush="White" Foreground="White"
                                            Cursor="Hand" Click="AbrirDocumento_Click"/>
                                </DockPanel>

                                <Border Grid.Row="1" Margin="0,14,0,0" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="8" Background="#FFF7F7F7" MinHeight="260">
                                    <Grid x:Name="panelDocumento" Margin="12">
                                        <Image x:Name="imgDocumento" Visibility="Collapsed" Stretch="Uniform" MaxHeight="330"/>

                                        <Grid x:Name="panelVideo" Visibility="Collapsed">
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition Height="44"/>
                                            </Grid.RowDefinitions>
                                            <MediaElement x:Name="mediaVideo" Grid.Row="0" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform"/>
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Content="Reproducir" Width="100" Height="30" Margin="4" Background="#9CA3AF" BorderBrush="White" Foreground="White" Click="Reproducir_Click"/>
                                                <Button Content="Pausar" Width="80" Height="30" Margin="4" Background="#D9D9D9" BorderBrush="White" Foreground="#616161" Click="Pausar_Click"/>
                                            </StackPanel>
                                        </Grid>

                                        <WebBrowser x:Name="pdfViewer" Visibility="Collapsed" Height="330"/>

                                        <TextBlock x:Name="txtSinDocumento" Visibility="Collapsed" Text="Sin documento adjunto" Foreground="#9CA3AF" FontSize="18" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Eliminar reporte" Height="42" Width="150" Margin="0,0,10,0"
                                Background="#D9D9D9" BorderBrush="White" Foreground="#616161" FontSize="15" Cursor="Hand"
                                Click="EliminarReporte_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="20"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Content="Moderar contenido" Height="42" Width="170" Margin="0,0,10,0"
                                Background="#616161" BorderBrush="White" Foreground="White" FontSize="15" Cursor="Hand"
                                Click="Moderar_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="20"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Content="Cerrar" Height="42" Width="130"
                                Background="#9CA3AF" BorderBrush="White" Foreground="White" FontSize="15" Cursor="Hand"
                                Click="Cerrar_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="20"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
