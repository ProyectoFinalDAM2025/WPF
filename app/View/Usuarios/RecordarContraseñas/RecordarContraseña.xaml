<Window x:Class="app.View.Usuarios.RecordarContraseñas.RecordarContraseña"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:app.View.Usuarios.RecordarContraseñas"
        mc:Ignorable="d"
        Title="RecordarContraseña" Height="600" Width="1000"
        WindowStyle="none"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../Dictionary1.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Border CornerRadius="20" Background="White" BorderThickness="5">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#616161" Offset="1"/>
                    <GradientStop Color="#9CA3AF" Offset="0.75"/>
                    <GradientStop Color="#D9D9D9" Offset="0"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="30,10">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <Image Source="/View/Home/OFFICIUM.PNG" Width="200"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                        <Border BorderBrush="Black" Width="80" BorderThickness="2" Margin="0,20,20,20"/>
                        <TextBlock Text="Recordar contraseña" VerticalAlignment="Center" Foreground="{StaticResource ColorPrimario}" Style="{StaticResource TextBlockGeneral}"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Email" Margin="0,10" Style="{StaticResource TextBlockGeneral}"/>
                        <TextBox Name="txtEmail" Style="{StaticResource TextBoxGeneral}" Margin="0,0,0,10" TextChanged="TextBoxEmail_TextChanged"/>
                        <TextBlock x:Name="ErrorTextEmail" Text="* Email no válido" Style="{StaticResource ErrorText}" Visibility="Collapsed"/>

                        <TextBlock Text="Confirmar Email" Margin="0,10" Style="{StaticResource TextBlockGeneral}"/>
                        <TextBox Name="txtEmailConfirmar" Style="{StaticResource TextBoxGeneral}" Margin="0,0,0,10" TextChanged="TextBoxEmailConfirmar_TextChanged"/>
                        <TextBlock x:Name="ErrorTextEmailConfirmar" Text="* Email no válido" Style="{StaticResource ErrorText}" Visibility="Collapsed"/>
                        <TextBlock x:Name="ErrorTextEquals" Text="* Email no coincide" Style="{StaticResource ErrorText}" Visibility="Collapsed"/>
                    </StackPanel>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Button Name="btnEnviar"
                                Grid.Column="0"
                                IsEnabled="False"
                                Style="{StaticResource ButtonLogin}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Click="BtnEnviar_Click"
                                Cursor="Hand"/>

                        <Label Grid.Column="1"
                               Content="Regresar al LogIn..."
                               Style="{StaticResource LabelGeneral}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               MouseDown="Label_MouseDown"/>
                    </Grid>
                </StackPanel>

                <Border Grid.Column="1" CornerRadius="0,20,20,0" ClipToBounds="True">
                    <Border.Background>
                        <ImageBrush ImageSource="/View/Usuarios/RecordarContraseñas\recover.jpg" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
